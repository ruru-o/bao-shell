{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "C:/Users/User/.config/fastfetch/ascii.txt",
    "color": {
      "1": "#FFFFFF",
      "2": "#F5FBFF",
      "3": "#EAF7FF",
      "4": "#D9F0FF",
      "5": "#C7E8FF",
      "6": "#A9D9FF",
      "7": "#8CC8FF",
      "8": "#70B5F5",
      "9": "#579DEB"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "#B8E7FF",
        "at": "#DDF2FF",
        "host": "#9FD1FF"
      }
    },
    "break",
    {
      "type": "custom",
      "key": " ",
      "keyColor": "#9FD1FF",
      "format": "┌─ System ───────────────────────────"
    },
    {
      "type": "os",
      "key": "",
      "keyColor": "#9FD1FF",
      "format": "{name} {version} {codename}"
    },
    {
      "type": "kernel",
      "key": "",
      "keyColor": "#81BFFF",
      "format": "{release}"
    },
    "break",
    {
      "type": "custom",
      "key": " ",
      "keyColor": "#AED9FF",
      "format": "┌─ Hardware ─────────────────────────"
    },
    {
      "type": "cpu",
      "key": "",
      "keyColor": "#B8E7FF",
      "format": "{name} @ {freq-base}"
    },
    {
      "type": "gpu",
      "key": "󰢮",
      "keyColor": "#90C8FF",
      "format": "{name}"
    },
    {
      "type": "board",
      "key": "󰚗",
      "keyColor": "#AED9FF",
      "format": "{name} (Rev {version})"
    },
    {
      "type": "bios",
      "key": "󰒓",
      "keyColor": "#72B6FF",
      "format": "{vendor} {version}"
    },
    {
      "type": "memory",
      "key": "",
      "keyColor": "#81BFFF",
      "format": "{used} / {total} ({percentage})"
    },
    "break",
    {
      "type": "custom",
      "key": " ",
      "keyColor": "#AED9FF",
      "format": "┌─ Desktop ──────────────────────────"
    },
    {
      "type": "monitor",
      "key": "󰍹",
      "keyColor": "#AED9FF",
      "format": "{width}x{height} @ {refresh-rate} Hz"
    },
    {
      "type": "disk",
      "key": "",
      "keyColor": "#CFEAFF",
      "format": "{size-used} / {size-total} ({size-percentage}) - {filesystem}"
    },
    "break",
    {
      "type": "custom",
      "key": " ",
      "keyColor": "#DDF2FF",
      "format": "┌─ Uptime ────────────────────────────"
    },
    {
      "type": "uptime",
      "key": "󰀄",
      "keyColor": "#DDF2FF",
      "format": "{formatted}"
    },
    "break"
  ],
  "display": {
    "percent": {
      "type": 9,
      "color": {
        "green": "#A9D9FF",
        "yellow": "#70B5F5",
        "red": "#579DEB"
      }
    }
  }
}
